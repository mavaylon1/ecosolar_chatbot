# OpenAI — used server-side only for chat completions and embeddings.
# Never prefix this with NEXT_PUBLIC_ — it must not reach the browser.
OPENAI_API_KEY=

# ── api-server authentication (see DEPLOYMENT.md item #12) ─────────────────
# Before every OpenAI call, /api/chat validates API_SERVER_KEY against
# api-server's /internal/validate-key — the same handshake widget-server
# already uses for its own OpenAI usage. If validation fails (key missing,
# revoked, or api-server unreachable), the chat request is blocked before
# any OpenAI call is made. After each turn, token usage is reported back via
# /internal/track-tokens. Leave all three unset locally on purpose — same
# no-op-when-unset pattern as ALLOWED_EMBED_ORIGINS/SITE_ORIGIN below, so
# `npm run dev` works without a live api-server/Neon connection.

# Full URL of the deployed api-server, e.g. https://truvala-api-server.vercel.app
API_SERVER_URL=

# The trv_... key from api-server/scripts/seed-ecosolar.js
API_SERVER_KEY=

# Shared secret — must match api-server's INTERNAL_SECRET exactly
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_SECRET=

# Comma-separated list of full origins allowed to iframe /embed/[clientId]
# (CSP frame-ancestors — see DEPLOYMENT.md item #3). Leave unset locally;
# only needs to be set in Vercel's real deployment once the production (and
# staging, if any) domain(s) are known.
# Example: ALLOWED_EMBED_ORIGINS=https://ecosolarusa.com,https://www.ecosolarusa.com
ALLOWED_EMBED_ORIGINS=

# Our OWN deployed domain (not the client's) — /api/chat rejects any request
# whose Origin header doesn't match this, so someone can't call the API
# directly, bypassing the widget/iframe entirely (see DEPLOYMENT.md item #4).
# Leave unset locally, so nothing is restricted in dev. Assumed value for now
# (unverified until the CTO's Vercel project is actually created — confirm
# the project name produced exactly this, or update if it didn't):
# SITE_ORIGIN=https://ecosolar-chatbot.vercel.app
SITE_ORIGIN=
